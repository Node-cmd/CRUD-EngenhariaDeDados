  <transform>
    <type>TableInput</type>
    <name>Entrada via tabela</name>
    <sql>WITH estudante_campus AS (
    -- campus "atual" de cada estudante, baseado no vínculo mais recente
    SELECT DISTINCT ON (v.mat_estudante)
        v.mat_estudante,
        cur.campus
    FROM universidade.vinculo v
    JOIN universidade.curso cur ON cur.idCurso = v.curso
    ORDER BY v.mat_estudante, v.data_entrada DESC
),

professores_turma AS (
    -- concatena os nomes de todos os professores que lecionam cada turma
    SELECT
        l.id_turma,
        STRING_AGG(u.nome, ', ' ORDER BY u.nome) AS professores
    FROM universidade.leciona l
    JOIN universidade.professor p ON p.mat_professor = l.mat_professor
    JOIN universidade.usuario u   ON u.cpf = p.cpf
    GROUP BY l.id_turma
)

SELECT
    MODE() WITHIN GROUP (ORDER BY ec.campus)          AS campus_turma,
    d.nome                                             AS disciplina,
    d.cod_disc                                         AS codigo_disciplina,
    t.ano,
    t.semestre                                         AS periodo,
    pt.professores                                     AS professor,
    COUNT(c.mat_estudante)                             AS qtd_matriculados,
    COUNT(*) FILTER (WHERE c.nota >= 5)                AS qtd_aprovados,
    COUNT(*) FILTER (WHERE c.nota &lt; 5)                 AS qtd_reprovados,
    ROUND(AVG(c.nota)::numeric, 2)                     AS media_notas,
    'T' || t.numero                                    AS codigo_turma
FROM universidade.turma t
JOIN universidade.disciplina d      ON d.cod_disc = t.cod_disc
JOIN universidade.cursa c           ON c.id_turma = t.id_turma
LEFT JOIN estudante_campus ec       ON ec.mat_estudante = c.mat_estudante
LEFT JOIN professores_turma pt      ON pt.id_turma = t.id_turma
GROUP BY
    t.id_turma, t.cod_disc, t.numero, t.ano, t.semestre,
    d.nome, d.cod_disc, pt.professores
ORDER BY
    t.ano, t.semestre, d.cod_disc, t.numero;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Crud</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
